{% assign heading = trmnl.plugin_settings.custom_fields_values.heading | default: title | default: "Embalses" %}
{% comment %} TRMNL stores a select's value parameterised ("España" -> "espana"),
   so match loosely on a downcased value rather than on the exact label. {% endcomment %}
{% assign footer_mode = trmnl.plugin_settings.custom_fields_values.footer | default: "espana" | downcase %}
{% comment %} The payload carries every reservoir embalses.net reports weekly, as
   short keys holding plain numbers, because TRMNL caps a polling payload at
   100 kB: n name, b basin, pv province, r river, v hm3 stored, c hm3 total,
   d hm3 change this week, p % full, ly % same week last year, a % ten-year
   average. The reservoir_ids form field picks which to show, in the order
   given; an id is the number in the page URL, so /pantano-871-rules.html is
   871. With the field empty we fall back to the ids in the payload. {% endcomment %}
{% assign chart_field = trmnl.plugin_settings.custom_fields_values.chart | default: "no" | downcase %}
{% assign show_chart = false %}
{% if chart_field == "si" or chart_field == "sí" or chart_field == "yes" or chart_field == "true" or chart_field == "1" %}{% assign show_chart = true %}{% endif %}
{% assign selection = trmnl.plugin_settings.custom_fields_values.reservoir_ids | default: default_ids %}
{% assign wanted = selection | split: "," %}
{% assign list = "" | split: "," %}
{% for token in wanted %}{% assign key = token | strip %}{% assign found = reservoirs | where: "id", key %}{% assign list = list | concat: found %}{% endfor %}
{% assign shown = list.size | default: 0 %}

<style>
  /* The one thing the framework has no component for: a marker on the track
     showing where this week sits in the ten-year average. White with a black
     outline so it stays visible over the fill and over the empty track. */
  .emb-mark { position: absolute; top: 0; height: 100%; width: 3px; margin-left: -1px;
              background: #fff; box-shadow: 0 0 0 1px #000; }
  /* The framework centres what sits in a layout; these views are left aligned,
     so every block takes the full width and lines up on the left edge. */
  .layout > *:not(img) { width: 100%; }

  /* embalses.net draws its chart in colour, and a straight greyscale leaves the
     pale min/max band as heavy dithered hatching. Dimming before a contrast
     boost drops that band and the gridlines to white while all four series stay
     black — including the green 2024 line, which a brighter setting loses
     entirely. Left at its own 560x250 so the 1px lines and small labels land on
     whole pixels rather than being resampled. */
  /* One or two reservoirs: a taller track, so the rows fill the screen instead
     of floating in it. */
  .emb-tall .track { height: 58px; }

  .emb-chart { display: block; margin: 0 auto; flex: none; width: 560px; height: 250px;
               filter: grayscale(1) brightness(0.8) contrast(4); }
</style>

{% if shown == 0 %}
  <div class="layout layout--col layout--center" style="text-align: center;">
    <div class="title">Ningún embalse seleccionado</div>
    <div class="description">Pon los ids de embalses.net en el campo "Embalses" del plugin, separados por comas</div>
  </div>

{% elsif shown == 1 and show_chart %}
  {% assign r = list[0] %}
  <div class="layout layout--col gap--distribute">
    <div class="flex flex--row flex--between flex--bottom">
      <div class="flex flex--col flex--left gap--none">
        <span class="title title--large">{{ r.n }}</span>
        <span class="label label--small">{{ r.b }}{% if r.pv %} &middot; {{ r.pv }}{% endif %} &middot; {{ r.v }} / {{ r.c }} hm&sup3;</span>
      </div>
      <span class="value value--large value--tnums">{{ r.p | round: 1 | replace: ".", "," }}%</span>
    </div>

    {% comment %} The chart shows this year against the last two and the ten-year
       average, which is what the stat tiles say in the plain view, so those go.
       Graph by Embalses.net, CC BY 4.0. {% endcomment %}
    <img class="emb-chart" src="https://www.embalses.net/cache/pantano-{{ r.id }}.png"
         alt="Gráfico anual del embalse {{ r.n }}" />

    <div class="flex flex--row flex--between flex--bottom" style="border-top: 2px solid black; padding-top: 6px;">
      <span class="label label--small">Semana {% if r.d > 0 %}▲ +{% elsif r.d < 0 %}▼ {% else %}▬ {% endif %}{{ r.d }} hm&sup3; &middot; España {{ national.percent_text }}%</span>
      <span class="label label--small">gráfico: embalses.net CC BY 4.0</span>
    </div>
  </div>

{% elsif shown == 1 %}
  {% assign r = list[0] %}
  <div class="layout layout--col gap--distribute">
    <div class="flex flex--col flex--left gap--none">
      <span class="title title--xlarge">{{ r.n }}</span>
      <span class="description">
        {{ r.b }}{% if r.pv %} &middot; {{ r.pv }}{% endif %}{% if r.r %} &middot; Río {{ r.r }}{% endif %}
      </span>
    </div>

    <div class="flex flex--row flex--left flex--bottom gap--large">
      <span class="value value--xxlarge value--tnums">{{ r.p | round: 1 | replace: ".", "," }}%</span>
      <div class="flex flex--col flex--left gap--none" style="padding-bottom: 12px;">
        <span class="value value--xsmall value--tnums">{{ r.v }} hm&sup3;</span>
        <span class="label label--small">de {{ r.c }} hm&sup3;</span>
      </div>
    </div>

    <div class="progress-bar progress-bar--large">
      <div class="content">
        <span class="label label--small">Llenado</span>
        {% if r.a %}<span class="label label--small">línea = media de 10 años ({{ r.a | round: 1 | replace: ".", "," }}%)</span>{% endif %}
      </div>
      <div class="track">
        <div class="fill" style="width: {{ r.p }}%"></div>
        {% if r.a %}<div class="emb-mark" style="left: {{ r.a }}%"></div>{% endif %}
      </div>
    </div>

    <div class="grid grid--cols-4">
      <div class="col flex flex--col flex--left gap--none">
        <span class="label label--small">Semana</span>
        <span class="value value--small value--tnums">{% if r.d > 0 %}▲ +{% elsif r.d < 0 %}▼ {% else %}▬ {% endif %}{{ r.d }}</span>
        <span class="label label--small">hm&sup3;</span>
      </div>
      <div class="col flex flex--col flex--left gap--none">
        <span class="label label--small">{{ last_year_label | default: "Año pasado" }}</span>
        <span class="value value--small value--tnums">{% if r.ly %}{{ r.ly | round: 1 | replace: ".", "," }}%{% else %}—{% endif %}</span>
        {% if r.ly %}{% assign delta = r.p | minus: r.ly | round: 1 %}<span class="label label--small">{% if delta > 0 %}+{% endif %}{{ delta | replace: ".", "," }} puntos</span>{% endif %}
      </div>
      <div class="col flex flex--col flex--left gap--none">
        <span class="label label--small">Media 10 años</span>
        <span class="value value--small value--tnums">{% if r.a %}{{ r.a | round: 1 | replace: ".", "," }}%{% else %}—{% endif %}</span>
        {% if r.a %}{% assign delta = r.p | minus: r.a | round: 1 %}<span class="label label--small">{% if delta > 0 %}+{% endif %}{{ delta | replace: ".", "," }} puntos</span>{% endif %}
      </div>
      <div class="col flex flex--col flex--left gap--none">
        <span class="label label--small">España</span>
        <span class="value value--small value--tnums">{{ national.percent_text }}%</span>
        <span class="label label--small">{{ national.trend_glyph }} {{ national.change_text }} hm&sup3;</span>
      </div>
    </div>
  </div>

{% else %}
  {% comment %} Free space has to go somewhere, and on a 480px screen two rows
     leave a lot of it. Rather than distribute it as gaps, the rows themselves
     grow: fewer reservoirs means a taller track and bigger type, which reads
     from further away. {% endcomment %}
  {% if shown <= 2 %}{% assign bar_size = "progress-bar--large emb-tall" %}{% assign name_size = "title title--large" %}{% assign pct_size = "value value--large" %}
  {% elsif shown <= 3 %}{% assign bar_size = "progress-bar--large" %}{% assign name_size = "title" %}{% assign pct_size = "value value--small" %}
  {% elsif shown <= 5 %}{% assign bar_size = "progress-bar--base" %}{% assign name_size = "title title--small" %}{% assign pct_size = "value value--xsmall" %}
  {% else %}{% assign bar_size = "progress-bar--small" %}{% assign name_size = "title title--small" %}{% assign pct_size = "value value--xxsmall" %}{% endif %}

  <div class="layout layout--col gap--distribute">
    {% for r in list limit: 7 %}
      <div class="progress-bar {{ bar_size }}">
        <div class="content">
          <span class="{{ name_size }}">{{ r.n }}</span>
          <span class="label label--small">{{ r.v }} / {{ r.c }} hm&sup3; &middot; {% if r.d > 0 %}▲ +{% elsif r.d < 0 %}▼ {% else %}▬ {% endif %}{{ r.d }} sem.</span>
          <span class="{{ pct_size }} value--tnums">{{ r.p | round: 1 | replace: ".", "," }}%</span>
        </div>
        <div class="track">
          <div class="fill" style="width: {{ r.p }}%"></div>
          {% if r.a %}<div class="emb-mark" style="left: {{ r.a }}%"></div>{% endif %}
        </div>
      </div>
    {% endfor %}

    {% unless footer_mode contains "ningun" %}
      <div class="flex flex--row flex--between flex--bottom" style="border-top: 2px solid black; padding-top: 6px;">
      {% if footer_mode contains "conjunto" %}
        {% comment %} What "the total" covers depends on which ids were chosen, so
           it is added up here rather than in the payload. {% endcomment %}
        {% assign sum_volume = 0 %}{% assign sum_capacity = 0 %}{% assign sum_change = 0 %}
        {% for r in list %}{% assign sum_volume = sum_volume | plus: r.v %}{% assign sum_capacity = sum_capacity | plus: r.c %}{% assign sum_change = sum_change | plus: r.d %}{% endfor %}
        <span class="label label--small">Conjunto{% if sum_capacity > 0 %} {{ sum_volume | times: 100.0 | divided_by: sum_capacity | round: 1 | replace: ".", "," }}%{% endif %} &middot; {{ sum_volume }} / {{ sum_capacity }} hm&sup3; &middot; {% if sum_change > 0 %}+{% endif %}{{ sum_change }} hm&sup3; en la semana</span>
      {% else %}
        <span class="label label--small">España {{ national.percent_text }}% &middot; {{ national.volume_text }} / {{ national.capacity_text }} hm&sup3; &middot; {{ national.trend_glyph }} {{ national.change_text }} hm&sup3; en la semana</span>
      {% endif %}
        <span class="label label--small">línea = media 10 años</span>
    </div>
    {% endunless %}
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">{{ heading }}</span>
  <span class="instance">{{ as_of_label }}</span>
</div>
