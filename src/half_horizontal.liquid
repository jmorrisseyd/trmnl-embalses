{% assign heading = trmnl.plugin_settings.custom_fields_values.heading | default: title | default: "Embalses" %}
{% comment %} The payload carries every reservoir embalses.net reports weekly.
   The reservoir_ids form field picks which of them to show, in the order given;
   an id is the number in the page URL, so /pantano-871-rules.html is 871. With
   the field left empty we fall back to the ids baked into the payload. {% endcomment %}
{% assign selection = trmnl.plugin_settings.custom_fields_values.reservoir_ids | default: default_ids %}
{% assign wanted = selection | split: "," %}
{% assign list = "" | split: "," %}
{% for token in wanted %}{% assign key = token | strip %}{% assign found = reservoirs | where: "id_text", key %}{% assign list = list | concat: found %}{% endfor %}
{% assign shown = list.size | default: 0 %}

<style>
  .emb-mark { position: absolute; top: 0; height: 100%; width: 3px; margin-left: -1px;
              background: #fff; box-shadow: 0 0 0 1px #000; }
  /* The framework centres what sits in a layout; these views are left aligned,
     so every block takes the full width and lines up on the left edge. */
  .layout > * { width: 100%; }
</style>

{% if shown == 0 %}
  <div class="layout layout--col layout--center" style="text-align: center;">
    <span class="title title--small">Revisa los ids del plugin</span>
</div>

{% elsif shown == 1 %}
  {% assign r = list[0] %}
  <div class="layout layout--col gap--space-between">
    <div class="flex flex--row flex--between flex--bottom">
      <div class="flex flex--col flex--left gap--none">
        <span class="title">{{ r.name }}</span>
        <span class="label label--small">{{ r.volume_text }} / {{ r.capacity_text }} hm&sup3; &middot; {{ r.basin }}</span>
    </div>
      <span class="value value--large value--tnums">{{ r.percent_text }}%</span>
  </div>

    <div class="progress-bar progress-bar--base">
      <div class="track">
        <div class="fill" style="width: {{ r.bar_percent }}%"></div>
        {% if r.avg10_bar_percent %}<div class="emb-mark" style="left: {{ r.avg10_bar_percent }}%"></div>{% endif %}
    </div>
  </div>

    <div class="flex flex--row flex--between">
      <span class="label label--small">Semana {{ r.trend_glyph }} {{ r.change_text }} hm&sup3;</span>
      <span class="label label--small">{{ r.last_year_label | default: "Año pasado" }} {{ r.last_year_text }}%</span>
      <span class="label label--small">Media 10 años {{ r.avg10_text }}%</span>
      <span class="label label--small">España {{ national.percent_text }}%</span>
  </div>
</div>

{% else %}
  <div class="layout layout--col gap--space-between">
    {% for r in list limit: 3 %}
      <div class="progress-bar progress-bar--small">
        <div class="content">
          <span class="title title--small">{{ r.name }}</span>
          <span class="label label--small">{{ r.volume_text }} / {{ r.capacity_text }} hm&sup3;</span>
          <span class="value value--xxsmall value--tnums">{{ r.percent_text }}%</span>
      </div>
        <div class="track">
          <div class="fill" style="width: {{ r.bar_percent }}%"></div>
          {% if r.avg10_bar_percent %}<div class="emb-mark" style="left: {{ r.avg10_bar_percent }}%"></div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% if shown > 3 %}
      <span class="label label--small">y {{ shown | minus: 3 }} embalse(s) más</span>
    {% endif %}
</div>
{% endif %}

<div class="title_bar title_bar--small">
  <span class="title">{{ heading }}</span>
  <span class="instance">{{ as_of_label }}</span>
</div>
